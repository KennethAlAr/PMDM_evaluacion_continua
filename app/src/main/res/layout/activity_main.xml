<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/fondo_main_activity">

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/mugiwara_logo"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App Piece"
        android:textSize="42dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:fontFamily="sans-serif-condensed"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:textColor="#1A1A1A"
        android:text="La App para fans de One Piece"/>

<!--En ves de usar Button normal, usamos AppCompatButton para poder personalizarlos con fondos xml-->
    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Openings"
        android:backgroundTint="@null"
        android:background="@drawable/fondo_opening_item"
        android:id="@+id/btnOpenings"
        android:layout_marginVertical="5dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:fontFamily="sans-serif-condensed"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Melodías del Grand Line"
        android:backgroundTint="@null"
        android:background="@drawable/fondo_ost_item"
        android:id="@+id/btnOST"
        android:layout_marginVertical="5dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:fontFamily="sans-serif-condensed"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mugiwaras"
        android:backgroundTint="@null"
        android:background="@drawable/fondo_mugiwaras_button"
        android:id="@+id/btnNakamas"
        android:layout_marginVertical="5dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:fontFamily="sans-serif-condensed"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡¿Quién es tu capitán?!"
        android:backgroundTint="@null"
        android:background="@drawable/fondo_capitan_button"
        android:id="@+id/btnCapitanes"
        android:layout_marginVertical="5dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:fontFamily="sans-serif-condensed"/>

</LinearLayout>