<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:orientation="vertical"
    android:background="@drawable/fondo_capitanes_activity"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#1D1D1D"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif-condensed"
        android:text="¡¿Quién es tu Capitán?!"/>

    <ImageView
        android:id="@+id/imgCapitan"
        android:layout_width="225dp"
        android:layout_height="350dp"
        android:adjustViewBounds="true"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:padding="3dp"
        android:background="#000000"
        android:src="@drawable/pj_unknown"/>

    <TextView
        android:id="@+id/txtNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="15dp"/>

    <TextView
        android:id="@+id/txtTripulacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="20sp"
        android:textColor="#1A1A1A"
        android:layout_marginTop="4dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

<!--En ves de usar Button normal, usamos AppCompatButton para poder personalizarlos con fondos xml-->
    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡Descubre tu Capitán!"
        android:backgroundTint="@null"
        android:background="@drawable/fondo_capitan_item"
        android:id="@+id/btnCapitan"
        android:layout_marginVertical="3dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:fontFamily="sans-serif-condensed"/>

<!--Ponemos un colchón de 50dp debajo del botón para que no aparezca pegado a la parte inferior
de la pantalla-->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp" />

</LinearLayout>